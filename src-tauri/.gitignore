# Artefatos de build do Tauri/Cargo
/target
# Código gerado pelo tauri-build (schemas, ícones processados)
/gen
# Runtime Python embarcado — pesado, gerado por scripts/empacotar_runtime.sh
/resources/runtime
# Ícones derivados (gerados por `cargo tauri icon icons/icon.png`)
/icons/*.icns
/icons/*.ico
/icons/*@2x.png
/icons/Square*.png
/icons/StoreLogo.png
/icons/128x128*.png
/icons/32x32.png
